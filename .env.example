# Application
NODE_ENV=development
PORT=8787
APP_BASE_URL=http://localhost:8787
DATA_DIR=./data

# Database. Production must use postgres and will refuse pglite or JSON.
DATABASE_PROVIDER=pglite
DATABASE_URL=postgres://nightcamfinds:example-password@localhost:5432/nightcamfinds

# Providers. Campaign IDs are configuration, not secrets.
CHATURBATE_WM=C6yxN
CHATURBATE_API_BASE=https://chaturbate.com/api/public/affiliates/onlinerooms/
CHATURBATE_ENABLED=true
BONGACASH_CAMPAIGN=840970
BONGACASH_PROGRAM=RevShare
BONGACASH_API_BASE=
BONGACASH_ENABLED=false
BONGACASH_POSTBACKS=false

# Affiliate. Do not put live destination secrets here.
AFFILIATE_ALLOWLIST=chaturbate.com

# Security. Replace every example before production.
# OWNER_MFA_SECRET must be a Base32 TOTP secret, at least 16 characters, in production.
# Generate it in your secret manager. Do not commit it. The app never writes it to the database.
ADMIN_USER=owner
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-session-secret-value
OWNER_MFA_SECRET=

# Postbacks. Empty token means unauthenticated dev intake only.
POSTBACK_TOKEN=

# Optional Redis. Not required at launch.
REDIS_URL=

# Optional email. Disabled until configured.
EMAIL_PROVIDER=
EMAIL_FROM=
