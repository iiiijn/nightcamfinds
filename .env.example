# Application
NODE_ENV=development
PORT=8787
APP_BASE_URL=http://localhost:8787
DATA_DIR=./data

# Database. Production uses Postgres.
DATABASE_PROVIDER=pglite
DATABASE_URL=postgres://nightcamfinds:example-password@localhost:5432/nightcamfinds

# Chaturbate feed
CHATURBATE_WM=C6yxN
CHATURBATE_API_BASE=https://chaturbate.com/api/public/affiliates/onlinerooms/
CHATURBATE_ENABLED=true
CB_CAMPAIGN=C6yxN
CB_TOUR=LQps
CB_POSTBACK_SECRET=replace-with-a-long-random-secret
# The postback endpoint is query-param authenticated only if your Chaturbate UI supports adding secret={secret}.
# Otherwise use a verified partner-supported protection method before production.

# BongaCams feed / BongaCash RevShare campaign
BONGACAMS_CAMPAIGN=840970
BONGACAMS_API_BASE=https://bngprm.com/promo.php
BONGACAMS_ENABLED=true
BONGACAMS_LIMIT=100

# Legacy BongaCash names retained for compatibility
BONGACASH_CAMPAIGN=840970
BONGACASH_PROGRAM=RevShare
BONGACASH_API_BASE=
BONGACASH_ENABLED=false
BONGACASH_POSTBACKS=false

# Affiliate. Do not put live destination secrets here.
AFFILIATE_ALLOWLIST=chaturbate.com,bongacams4.com

# Security. Replace every example before production.
ADMIN_USER=owner
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-session-secret-value
OWNER_MFA_SECRET=

# Postbacks. Empty token means unauthenticated dev intake only.
POSTBACK_TOKEN=
STATS_KEY=replace-with-a-long-random-dashboard-key

# Optional Redis. Not required at launch.
REDIS_URL=

# Optional email. Disabled until configured.
EMAIL_PROVIDER=
EMAIL_FROM=
